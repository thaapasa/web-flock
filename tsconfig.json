{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true

    // Deliberately NOT enabling noUncheckedIndexedAccess: the simulation's inner
    // loops index typed arrays constantly, and `number | undefined` there costs
    // readability and non-null assertions everywhere for no real safety.
  },
  "include": ["src", "vite.config.ts", "eslint.config.js"]
}
